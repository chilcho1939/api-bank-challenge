{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/provider/v1/execute",
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.accountId == 'acc-slow')]" }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 5000,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "transactionId": "txn-slow",
      "status": "APPROVED",
      "balance": 5500.00,
      "executedAt": "{{now}}"
    },
    "transformers": ["response-template"]
  }
}